# Tuned for a 512MB droplet. Deploying to a Raspberry Pi (2GB+)? Use
# systemd/pta-bot-pi.service instead — the memory cap below is too tight for no reason
# once RAM isn't scarce.
[Unit]
Description=PTA WhatsApp bot
After=network-online.target
Wants=network-online.target
# High enough that a WhatsApp-side outage does not rate-limit the unit into 'failed'.
# These belong in [Unit], not [Service] — misplaced here before, which systemd
# silently ignored ("Unknown key... ignoring"), leaving restarts genuinely unbounded.
StartLimitBurst=100
StartLimitIntervalSec=3600

[Service]
Type=simple
User=ptabot
WorkingDirectory=/opt/pta-bot
EnvironmentFile=/etc/pta-bot.env
ExecStart=/usr/bin/node --max-old-space-size=384 dist/main.js
Restart=always
RestartSec=10
# connection.ts exits 78 for disconnect reasons that are genuinely terminal (loggedOut,
# connectionReplaced) — retrying those is not transient-outage recovery, it's repeated
# unofficial registration attempts against WhatsApp's servers. Respect that instead of
# restarting through it: fix the pairing/credential problem by hand, then start again.
RestartPreventExitStatus=78
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pta-bot

[Install]
WantedBy=multi-user.target
