# Copy to .env and fill in. Required vars have no default and the process will not
# start without them (src/config.ts).

# WhatsApp group JID to monitor. Unknown on first run — start the bot, send a message
# in the group, and copy the JID that appears in the logs.
GROUP_JID=

# Your personal WhatsApp JID (DMs). Drafts, approvals, and admin commands go here.
ADMIN_JID=

# Anthropic API key used for nightly fact extraction and @bot answers.
ANTHROPIC_API_KEY=

# optin (default): only participants who reply #acepto are ingested.
# optout: everyone is ingested until they reply #salir.
# See CLAUDE.md invariant 3 before changing this after launch.
#CONSENT_MODE=optin

# Model used for the nightly batched extraction pass.
#EXTRACTION_MODEL=claude-haiku-4-5-20251001

# Model used for synchronous @bot mention answers.
#ANSWER_MODEL=claude-haiku-4-5-20251001

# Path to the SQLite database file.
#DB_PATH=./pta.db

# pino log level: trace | debug | info | warn | error | fatal
#LOG_LEVEL=info

# How many days of raw messages to keep before purge.
#RAW_RETENTION_DAYS=7

# How long an unconfirmed draft stays pending before it expires.
#DRAFT_TTL_HOURS=12

# Minimum seconds between @bot answers for the same participant. Protects against
# an unbounded Anthropic API bill from one parent spamming the mention.
#ANSWER_COOLDOWN_SECONDS=60

# Alternative to scanning the QR on first pairing: WhatsApp > Linked Devices > Link
# with phone number, then type the code the bot logs. Digits only, country code
# included, no '+' (e.g. 573001234567 for a Colombian number). Only used while unpaired
# — harmless to leave set afterward.
# CONFIRMED BROKEN against baileys 6.7.24 (2026-08-21): the pairing code is issued, then
# WhatsApp's server closes the connection within ~100ms — before it's possible to enter
# it. Repeated attempts triggered what looked like registration rate-limiting on the
# device. Do not set this until a Baileys release is confirmed to fix it. Use the QR
# instead, watched live (`journalctl -u pta-bot-pi -f`) rather than relayed secondhand,
# since it expires fast.
#PAIRING_NUMBER=

# --- scripts/backup.sh (not read by the app process) ---

# age public key backups are encrypted to. Required for backup.sh to run.
#AGE_RECIPIENT=

# rclone remote:path for encrypted snapshots.
#RCLONE_REMOTE=r2:pta-bot-backups
